# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for Claude models (Claude 3.7 Sonnet, 3.5 Sonnet, Haiku, Opus).
ANTHROPIC_API_KEY=

# MOONSHOT_API_KEY: Required for Moonshot / Kimi models (Kimi K3, K1.5, Moonshot v1).
MOONSHOT_API_KEY=

# OPENAI_API_KEY: Required for OpenAI models (GPT-4o, GPT-4o-mini, o1, o3-mini).
OPENAI_API_KEY=

# DEEPSEEK_API_KEY: Required for DeepSeek models (DeepSeek R1, DeepSeek V3).
DEEPSEEK_API_KEY=

# GROQ_API_KEY: Required for ultra-fast Llama & open-source models via Groq.
GROQ_API_KEY=

# OPENROUTER_API_KEY: Required for unified multi-model routing via OpenRouter.
OPENROUTER_API_KEY=

# CUSTOM_API_KEY & BASE_URL: For self-hosted (Ollama, LM Studio, vLLM, custom proxy).
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

